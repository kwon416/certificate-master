# Supabase Configuration
# Get these values by running: supabase status -o env
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_anon_key_from_supabase_status
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_from_supabase_status
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# MariaDB Configuration # ** docker를 쓰지 않을 경우에 선언 **
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=your_mariadb_user
MARIADB_PASSWORD=your_mariadb_password
MARIADB_DATABASE=certificate_master

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs
BRAVE_API_KEY=your_brave_api_key_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Brave Search 설정
BRAVE_SEARCH_RESULTS_PER_CATEGORY=5

# Pinecone Vector Store
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=certificate-master

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS Settings
CORS_ORIGINS=http://localhost:5100

# Celery (if using background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
