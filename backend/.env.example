# Supabase Configuration
# Get these values by running: supabase status -o env
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_anon_key_from_supabase_status
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_from_supabase_status
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# MariaDB Configuration # ** docker 사용시 HOST만 제거 **
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=your_mariadb_user
MARIADB_PASSWORD=your_mariadb_password
MARIADB_DATABASE=certificate_master

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs
BRAVE_API_KEY=your_brave_api_key_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024

# Brave Search 설정
BRAVE_SEARCH_RESULTS_PER_CATEGORY=5

# Search Provider Configuration
# "brave": Brave Search API (유료, 기본값)
# "searxng": SearXNG 메타 검색 엔진 (오픈소스, 무료)
SEARCH_PROVIDER=brave

# SearXNG Configuration (오픈소스 검색 엔진 사용 시)
# Docker: docker run -d -p 8888:8080 searxng/searxng
SEARXNG_BASE_URL=http://localhost:8888
SEARXNG_TIMEOUT=30.0

# Embedding Provider Configuration
# "openai": OpenAI API (유료, 기본값)
# "local": BGE-M3 로컬 모델 (무료, GPU 권장)
# 로컬 사용시: uv sync --extra local
EMBEDDING_PROVIDER=openai

# Pinecone Vector Store
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=certificate-master

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS Settings
CORS_ORIGINS=http://localhost:5100

# Celery (if using background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
