# Supabase Configuration
# Get these values by running: supabase status -o env
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_anon_key_from_supabase_status
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_from_supabase_status
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# MariaDB Configuration # ** docker 사용시 HOST만 제거 **
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=your_mariadb_user
MARIADB_PASSWORD=your_mariadb_password
MARIADB_DATABASE=certificate_master

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024

# ============================================================
# Provider 설정 (프로덕션 기본값)
# ============================================================
# 로컬 개발 시 .env.local 파일에 아래 값들을 오버라이드하세요.
# .env.local은 .env보다 우선 적용됩니다.

# Search Provider
# - searxng : SearXNG 메타 검색
# 설치: docker run -d -p 8888:8080 searxng/searxng
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8888
SEARXNG_TIMEOUT=30.0

# Embedding Provider
# - openai : OpenAI API (프로덕션, 유료)
# - local  : BGE-M3 로컬 모델 (로컬 개발용, 무료, GPU +2G VRAM)
# 로컬 설치: uv sync --extra local
EMBEDDING_PROVIDER=openai

# ============================================================
# 로컬 개발 환경 예시 (.env.local에 복사)
# ============================================================
# SEARCH_PROVIDER=searxng
# EMBEDDING_PROVIDER=local
# ============================================================

# Pinecone Vector Store
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=certificate-master

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS Settings
CORS_ORIGINS=http://localhost:5100

# Celery (if using background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
