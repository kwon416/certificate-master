# ============================================================
# Certificate Master Backend - 환경 설정 템플릿
# ============================================================
# 사용법:
#   개발: .env.development → .env 로 복사
#   운영: .env.production → .env 로 복사 (서버에서)
# ============================================================

# Supabase Configuration (필수)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# MariaDB Configuration (필수)
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=your_user
MARIADB_PASSWORD=your_password
MARIADB_DATABASE=certificate_master

# ChromaDB Configuration (필수)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=certificate-master-index

# OpenAI API (필수)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL_NAME=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024

# SearXNG Configuration (필수)
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8888
SEARXNG_TIMEOUT=30.0

# Embedding Provider (openai | local)
EMBEDDING_PROVIDER=openai

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS Settings (필수)
CORS_ORIGINS=http://localhost:5100

# Redis (선택)
REDIS_URL=redis://localhost:6379/0

# Celery (선택)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
